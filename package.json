{
  "name": "dsh-token-usage-hud",
  "description": "DSH Web 插件：在界面顶层悬浮显示当前对话的 token 消耗与费用消耗（本对话用量 HUD）。",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user-Mrz/dsh-token-usage-hud.git"
  },
  "license": "MIT"
}
